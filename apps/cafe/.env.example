# Copy to .env.local and fill in real values. Never commit .env* files.
# All variables below are SERVER-ONLY unless prefixed NEXT_PUBLIC_.

# ─── Backend (FastAPI on Railway) ───
# The browser never calls Railway directly. Every /api/v1/* request goes through
# the same-origin BFF proxy (src/app/api/v1/[...path]/route.ts), which attaches
# the access token from an HttpOnly cookie. Must be https (http only for localhost).
RAILWAY_API_URL="https://caf-pos-repo-production.up.railway.app"

# DO NOT set NEXT_PUBLIC_API_BASE_URL. It used to point the browser straight at
# Railway; with the cookie BFF that bypasses auth and breaks login (audit m4).

# Extra origins allowed to send state-changing requests (comma-separated, exact
# origins). The app's own origin is always allowed. Usually leave empty.
ALLOWED_ORIGINS=""

# ─── Local print bridge (bridge/server.mjs) ───
# Shop-wide shared secret. The bridge refuses every request without it, and the
# app fetches it from /api/auth/bridge-token (logged-in users only).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Put the SAME value in %ProgramData%\cafe-pos-bridge\bridge-token.txt on each POS PC.
BRIDGE_TOKEN=""

# ─── Cloudflare R2 (menu images) ───
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public bucket base (pub-<id>.r2.dev or custom domain). Used for the next/image
# allowlist and the CSP img-src.
R2_PUBLIC_URL=""

# ─── Application ───
NEXT_PUBLIC_APP_NAME="Kafé OS"
