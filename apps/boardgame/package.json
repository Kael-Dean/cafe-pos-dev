{
  "name": "@pos/boardgame",
  "version": "0.1.0",
  "private": true,
  "description": "Kafé OS — board-game café edition. @pos/core + time billing (rate plans), table-time product rules and the board-game extras.",
  "scripts": {
    "predev": "pos-sync-public",
    "dev": "next dev -H 127.0.0.1 -p 3001",
    "dev:lan": "pos-sync-public && next dev -H 0.0.0.0 -p 3001",
    "prebuild": "pos-sync-public",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3001",
    "start:lan": "next start -H 0.0.0.0 -p 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pos/core": "*",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
