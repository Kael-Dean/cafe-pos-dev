# Browser calls same-origin /api/v1 (BASE empty); Next.js rewrites to ADMIN_API_URL.
NEXT_PUBLIC_API_BASE_URL=

# FastAPI service that serves /api/v1/admin/*.
# Phase 1 is deployed to STAGING only — production does not have the admin
# router yet. Switch this to the production URL once it ships there.
ADMIN_API_URL=https://caf-pos-repo-staging.up.railway.app
